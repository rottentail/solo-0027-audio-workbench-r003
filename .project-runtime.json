{
  "language": "Python",
  "project_shape": "backend",
  "source_extensions": [
    ".py"
  ],
  "build_command": "python3 -m compileall -q audio_workbench",
  "testing": "unittest",
  "workflow_checks": [
    {
      "workflow_id": "inspect",
      "command": "python3 -m audio_workbench.smoke inspect"
    },
    {
      "workflow_id": "clip",
      "command": "python3 -m audio_workbench.smoke clip"
    },
    {
      "workflow_id": "mix",
      "command": "python3 -m audio_workbench.smoke mix"
    },
    {
      "workflow_id": "media-jobs",
      "command": "python3 -m audio_workbench.job_smoke"
    },
    {
      "workflow_id": "timeline",
      "command": "python3 -m audio_workbench.job_smoke"
    },
    {
      "workflow_id": "arrangement-render",
      "command": "python3 -m unittest discover -v"
    }
  ],
  "test_command": "python3 -m unittest discover -v"
}
